{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "CNAME",
      "README.md",
      "generate-*.js"
    ],
    "redirects": [
      {
        "regex": "^/(about|contact|devotional|events|mensgroups|mission|partners|podcast|transparency|videos)/?$",
        "destination": "/:1.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(json|xml)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      },
      {
        "source": "**/*.@(html)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico|mp4|mp3|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
