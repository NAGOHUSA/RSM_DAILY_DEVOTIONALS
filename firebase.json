{
  "hosting": {
    "public": ".",
    "ignore": [
      "gha-creds-*.json",
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "CNAME",
      "README.md",
      "generate-*.js"
    ],
    "redirects": [
      {
        "regex": "^/(about|contact|devotional|events|mensgroups|mission|partners|podcast|transparency|videos)/?$",
        "destination": "/:1.html",
        "type": 301
      },
      {
        "regex": "^/home/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "^/(about-us|our-team)/?$",
        "destination": "/about.html",
        "type": 301
      },
      {
        "regex": "^/groups/?$",
        "destination": "/mensgroups.html",
        "type": 301
      },
      {
        "regex": "^/(services|services_group)(/.*)?$",
        "destination": "/mensgroups.html",
        "type": 301
      },
      {
        "regex": "^/events?/.+$",
        "destination": "/events.html",
        "type": 301
      },
      {
        "regex": "^/(shop|cart|checkout|my-account)(/.*)?$",
        "destination": "/merch/",
        "type": 301
      },
      {
        "regex": "^/(product|product-category|product-tag)/.*$",
        "destination": "/merch/",
        "type": 301
      },
      {
        "regex": "^/feed/?$",
        "destination": "/blog/feed.xml",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "**/*.@(json|xml)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico|mp4|mp3|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
